{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/collin/BetterEnchantmentEffects/schema/recipe.schema.json",
  "title": "BetterEnchantmentEffects recipe, format 1",
  "description": "One recipe: what an enchantment, material or armor looks like, as signals, sources, masks and per-output layer stacks. Strings starting with @ reference another row; enum values are bare strings; anything discriminated is a one-key object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "keys"],
  "properties": {
    "format": { "const": 1 },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "imported": { "type": "string", "description": "\"<plugin> <version>\": written by the importer; present means generated and not yet edited. Delete it on taking ownership; a menu save drops it." },
    "meta": { "type": "object", "description": "Free-form, kept verbatim through load and save." },
    "keys": { "type": "array", "maxItems": 4096, "minItems": 1, "items": { "$ref": "#/$defs/key" }, "description": "Every keyword entry is required. If non-keyword entries exist, at least one must also match; otherwise all keywords alone select the recipe. magicEffect matches any base effect on the worn item's enchantment, not active spells on the wearer. effectShader matches any enchantment effect's shader. Winning effect keys scope enchantment magnitude/cost to their matching effect. Non-keyword matches determine priority; keyword-only recipes default to 20." },
    "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "description": "Composition order per placement, lower first; ties use definition load order. Sampling is independent of priority. Default by the strongest matched non-keyword selector, or keyword for a keyword-only recipe: default 0, enchanted 5, material 10, keyword 20, armor 30, effectShader 40, enchantment 50, magicEffect 60." },
    "merge": { "enum": ["stack", "replace", "sampled"], "description": "Different identities sharing keys participate independently. stack appends recipe groups; replace clears preceding groups on each selected geometry/surface/slot and on the actor-wide light target when an eligible light exists, preserving sibling outputs and enchantment instances. sampled selects one alternative per piece from canonically sorted recipe identities using a fixed actor-form-ID hash, independent of priority and file order. Same-identity later files replace definitions." },
    "clock": {
      "type": "object", "additionalProperties": false,
      "properties": { "speed": { "$ref": "#/$defs/number", "default": 1.0 } }
    },
    "signals": { "type": "object", "maxProperties": 4096, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/signal" } },
    "curves": { "type": "object", "maxProperties": 4096, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/annotatedExpression", "description": "An expression in the free variable x (and mean, the source's mean, where a source is being shaped); a bare string, or {\"expr\", \"note\"}." } },
    "sources": { "type": "object", "maxProperties": 4096, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/source" } },
    "masks": { "type": "object", "maxProperties": 4096, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/annotatedExpression", "description": "Evaluated per texel; source and mask names stand for images, signal names for the tick's scalars; a bare string, or {\"expr\", \"note\"}." } },
    "outputs": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/output" },
      "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "light" } } },
      "minContains": 0, "maxContains": 1,
      "description": "At most one light output; the studio refuses a second." },
    "shell": { "$ref": "#/$defs/shell" },
    "variants": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/variant" } }
  },

  "$defs": {
    "number": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38, "description": "A finite number representable within the float range used by the engine." },
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "ref": { "type": "string", "pattern": "^@[A-Za-z_][A-Za-z0-9_]*$", "description": "A reference to another row: @name." },
    "note": { "type": "string", "description": "Author documentation for this row, free text, shown to a reader of the recipe; distinct from the plugin's tooltips." },
    "annotatedExpression": { "oneOf": [ { "$ref": "#/$defs/expression" }, { "type": "object", "additionalProperties": false, "required": ["expr"], "properties": { "expr": { "$ref": "#/$defs/expression" }, "note": { "$ref": "#/$defs/note" } } } ] },
    "expression": { "type": "string", "minLength": 1, "description": "Numbers, [r, g, b] literals, @name, + - * /, parentheses, comparisons yielding 0 or 1, and/or/not, if(c, a, b), abs min max clamp saturate floor ceil frac sqrt pow sin cos step smoothstep lerp length distance dot cross normalize, time, pi. Arithmetic and the math functions are component-wise on vectors; comparisons, and/or/not, and an if() condition take a scalar (if() branches may be vectors). The vector functions take vectors only: length(v), distance(a, b) and dot(a, b) yield a scalar, cross(a, b) takes and yields vec3s, normalize(v) keeps its operand's size (a zero vector stays zero). Division by zero is 0; no ^." },
    "curveRef": { "$ref": "#/$defs/expression", "description": "@name of a declared curve, or an inline expression in x." },
    "form": { "type": "string", "minLength": 1, "pattern": "^(0[xX][0-9A-Fa-f]{1,8}~.+\\.(esm|esp|esl|ESM|ESP|ESL)|[A-Za-z_][A-Za-z0-9_]*)$", "description": "An editor ID, or 0x<local id>~<plugin file>." },
    "glob": { "type": "string", "minLength": 1, "description": "* is the only wildcard; case-insensitive; / and \\ are equal." },
    "eventId": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.*]*$" },
    "node": { "type": "string", "minLength": 1, "description": "A skeleton node name, e.g. \"NPC L Foot [Lft ]\"." },

    "param": { "oneOf": [ { "$ref": "#/$defs/number" }, { "$ref": "#/$defs/ref" } ], "description": "A number or @signal." },
    "vec2": { "oneOf": [ { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/param" } }, { "$ref": "#/$defs/ref" } ] },
    "vec3": { "oneOf": [ { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/param" } }, { "$ref": "#/$defs/ref" } ] },
    "color": { "$ref": "#/$defs/vec3", "description": "[r, g, b]; components above 1 mean 0..255 on read, written back as 0..1." },
    "numbers3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/number" } },
    "value": { "oneOf": [ { "$ref": "#/$defs/number" }, { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/number" } } ] },

    "key": {
      "oneOf": [
        { "const": "default" },
        { "const": "enchanted", "description": "Any worn piece that carries an enchantment." },
        { "$ref": "#/$defs/oneKey", "properties": { "magicEffect": { "$ref": "#/$defs/form" } }, "required": ["magicEffect"] },
        { "$ref": "#/$defs/oneKey", "properties": { "enchantment": { "$ref": "#/$defs/form" } }, "required": ["enchantment"] },
        { "$ref": "#/$defs/oneKey", "properties": { "effectShader": { "$ref": "#/$defs/form" } }, "required": ["effectShader"] },
        { "$ref": "#/$defs/oneKey", "properties": { "keyword": { "$ref": "#/$defs/form" } }, "required": ["keyword"] },
        { "$ref": "#/$defs/oneKey", "properties": { "material": { "$ref": "#/$defs/glob", "description": "Matches the piece's diffuse texture paths." } }, "required": ["material"] },
        { "$ref": "#/$defs/oneKey", "properties": { "armor": { "$ref": "#/$defs/form" } }, "required": ["armor"] }
      ]
    },
    "oneKey": { "type": "object", "minProperties": 1, "maxProperties": 1 },

    "selectorTerm": {
      "oneOf": [
        { "$ref": "#/$defs/oneKey", "properties": { "addon": { "$ref": "#/$defs/form" } }, "required": ["addon"] },
        { "$ref": "#/$defs/oneKey", "properties": { "geometry": { "$ref": "#/$defs/glob" } }, "required": ["geometry"] },
        { "$ref": "#/$defs/oneKey", "properties": { "texture": { "$ref": "#/$defs/glob" } }, "required": ["texture"] }
      ]
    },
    "selector": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/selectorTerm" }, "description": "Any term may match; empty means every geometry." },

    "signal": {
      "type": "object",
      "description": "Exactly one kind key plus optional curve.",
      "properties": { "curve": { "$ref": "#/$defs/curveRef" }, "note": { "$ref": "#/$defs/note" } },
      "oneOf": [
        { "$ref": "#/$defs/signalKind", "required": ["constant"], "properties": { "constant": { "$ref": "#/$defs/value" } } },
        { "$ref": "#/$defs/signalKind", "required": ["wave"], "properties": { "wave": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "base": { "$ref": "#/$defs/param" }, "amplitude": { "$ref": "#/$defs/param" },
              "period": { "$ref": "#/$defs/param" }, "phase": { "$ref": "#/$defs/param" },
              "waveform": { "enum": ["sine", "triangle", "square", "saw"] } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["ramp"], "properties": { "ramp": {
            "type": "object", "additionalProperties": false,
            "properties": { "from": { "$ref": "#/$defs/param" }, "to": { "$ref": "#/$defs/param" }, "seconds": { "$ref": "#/$defs/param" } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["efsh"], "properties": { "efsh": {
            "type": "object", "additionalProperties": false, "required": ["field", "record"],
            "properties": { "field": { "enum": ["fillAlpha", "fillColor", "edgeAlpha", "edgeColor", "scroll"] }, "record": { "$ref": "#/$defs/form" } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["av"], "properties": { "av": { "oneOf": [
            { "$ref": "#/$defs/name" },
            { "type": "object", "additionalProperties": false, "required": ["of"],
              "properties": { "of": { "$ref": "#/$defs/name" }, "measure": { "enum": ["current", "base", "permanent", "temporaryModifier", "damage", "max"] } } } ] } } },
        { "$ref": "#/$defs/signalKind", "required": ["actorState"], "properties": { "actorState": { "enum": ["inCombat", "sneaking", "weaponDrawn", "swimming", "sprinting", "mounted", "movementSpeed", "position", "target", "hasTarget"], "description": "inCombat, sneaking, weaponDrawn, swimming, sprinting, mounted, hasTarget (a combat target exists) are 0/1; movementSpeed is a scalar; position (the wearer) and target (the current combat target, zero when none — gate with hasTarget) are world positions (vec3). distance(@target, @position) gives the distance to the hostile. An NPC's combat AI maintains the target while fighting; on the player it follows the attack/crosshair focus." } } },
        { "$ref": "#/$defs/signalKind", "required": ["enchantment"], "properties": { "enchantment": { "enum": ["magnitude", "cost"] } } },
        { "$ref": "#/$defs/signalKind", "required": ["trigger"], "properties": { "trigger": { "$ref": "#/$defs/trigger" } } },
        { "$ref": "#/$defs/signalKind", "required": ["payload"], "properties": { "payload": { "$ref": "#/$defs/ref", "description": "Reads the named trigger's newest firing value, typed by the trigger's declared payload; holds between firings." } } },
        { "$ref": "#/$defs/signalKind", "required": ["counter"], "properties": { "counter": {
            "type": "object", "additionalProperties": false, "required": ["trigger"],
            "properties": { "trigger": { "$ref": "#/$defs/ref" }, "reset": { "$ref": "#/$defs/ref" }, "cap": { "$ref": "#/$defs/param" } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["accumulate"], "properties": { "accumulate": {
            "type": "object", "additionalProperties": false, "required": ["trigger"],
            "properties": { "trigger": { "$ref": "#/$defs/ref" }, "decay": { "$ref": "#/$defs/param" } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["noise"], "properties": { "noise": {
            "type": "object", "additionalProperties": false,
            "properties": { "frequency": { "$ref": "#/$defs/param" }, "amplitude": { "$ref": "#/$defs/param" }, "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["gradient"], "properties": { "gradient": {
            "type": "object", "additionalProperties": false, "required": ["t", "stops"],
            "properties": {
              "t": { "$ref": "#/$defs/param" },
              "stops": { "type": "array", "maxItems": 4096, "minItems": 1, "items": {
                "type": "object", "additionalProperties": false, "required": ["at", "color"],
                "properties": { "at": { "$ref": "#/$defs/number" }, "color": { "$ref": "#/$defs/color" } } } } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["rate"], "properties": { "rate": { "$ref": "#/$defs/ref", "description": "The referenced signal's change per second." } } },
        { "$ref": "#/$defs/signalKind", "required": ["smooth"], "properties": { "smooth": {
            "type": "object", "additionalProperties": false, "required": ["of"],
            "properties": { "of": { "$ref": "#/$defs/ref" }, "seconds": { "$ref": "#/$defs/param" } } } } },
        { "$ref": "#/$defs/signalKind", "required": ["toRoot"], "properties": { "toRoot": { "$ref": "#/$defs/ref", "description": "The referenced world-space position (vec3) expressed in the wearer's root space. A point transform: build a direction by subtracting two converted points so the translation cancels." } } },
        { "$ref": "#/$defs/signalKind", "required": ["expr"], "properties": { "expr": { "$ref": "#/$defs/expression" } } }
      ]
    },
    "signalKind": {
      "type": "object",
      "propertyNames": { "enum": ["curve", "note", "constant", "wave", "ramp", "efsh", "av", "actorState", "enchantment", "trigger", "payload", "counter", "accumulate", "noise", "gradient", "rate", "smooth", "toRoot", "expr"] },
      "minProperties": 1, "maxProperties": 3
    },

    "trigger": {
      "type": "object",
      "description": "A firing source: exactly one of event, plugin, when; lifetime, max and payload are common.",
      "properties": {
        "lifetime": { "$ref": "#/$defs/param", "description": "Seconds a firing lives." },
        "max": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Live firings kept; older ones are dropped." },
        "payload": { "enum": ["scalar", "vec2", "vec3"], "default": "scalar", "description": "The type of the value a firing carries. A firing of another type is dropped and counted. Rich occurrences arrive as suffixed ids (equip.position, or a sender's precision.hit.position), one typed value each." },
        "anchor": { "oneOf": [ { "const": "world", "description": "The vec3 payload is a world position; requires payload vec3." }, { "type": "object", "additionalProperties": false, "required": ["node"], "properties": { "node": { "$ref": "#/$defs/node" } }, "description": "Firings locate at this skeleton node, resolved per geometry; a firing carrying its own node overrides it." } ], "description": "The space a firing's location resolves in. Absent means the trigger is unlocated and its payload is just a value." }
      },
      "oneOf": [
        { "type": "object", "required": ["event"], "additionalProperties": false,
          "properties": {
            "event": { "$ref": "#/$defs/eventId", "description": "Id glob on the bus: built-in anim.<graph event>, equip, equip.position, hit.received, hit.received.position (the attacker's position), hit.dealt, hit.dealt.position (the struck actor's position), or a provider's ids." },
            "filter": { "type": "object", "additionalProperties": false,
              "properties": { "node": { "$ref": "#/$defs/glob" }, "arg": { "$ref": "#/$defs/glob" },
                "value": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "oneOf": [{ "$ref": "#/$defs/number" }, { "type": "null" }] } } } },
            "lifetime": {}, "max": {}, "payload": {}, "anchor": {} } },
        { "type": "object", "required": ["plugin"], "additionalProperties": false,
          "properties": { "plugin": { "$ref": "#/$defs/eventId", "description": "An id another SKSE plugin fires through the messaging channel." }, "lifetime": {}, "max": {}, "payload": {}, "anchor": {} } },
        { "type": "object", "required": ["when"], "additionalProperties": false,
          "properties": {
            "when": { "$ref": "#/$defs/ref", "description": "Fires on the tick this scalar goes from at most 0 to above 0." },
            "value": { "$ref": "#/$defs/ref", "description": "Signal sampled into the firing's value; its type must match the declared payload." },
            "lifetime": {}, "max": {}, "payload": {}, "anchor": {} } }
      ]
    },

    "source": {
      "type": "object", "minProperties": 1, "maxProperties": 2,
      "properties": { "note": { "$ref": "#/$defs/note" } },
      "oneOf": [
        { "required": ["image"], "properties": { "image": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "description": "Relative to Data/Textures." },
              "channel": { "enum": ["rgb", "r", "g", "b", "a", "luma"] },
              "space": { "enum": ["tiled", "mesh"] },
              "scroll": { "$ref": "#/$defs/vec2" }, "tile": { "$ref": "#/$defs/vec2" },
              "mirror": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "boolean" } },
              "transpose": { "type": "boolean" }, "mip": { "$ref": "#/$defs/number", "minimum": 0 } } } } },
        { "required": ["material"], "properties": { "material": { "enum": ["diffuseRgb", "diffuseLuma", "normalSlope", "normalRgb", "roughness", "metallic", "occlusion", "reflectance", "rmaosRgb", "displacement", "relief"], "description": "The worn piece's own maps. diffuseRgb, normalRgb and rmaosRgb are the raw vec3 reads; with dot() any single channel derives from them (roughness = dot(@rmaosRgb, [1, 0, 0])), and the named scalars remain as the PBR vocabulary. relief is the best available relief detail, not a stored map: the displacement map when it is non-flat, else occlusion." } } },
        { "required": ["bake"], "properties": { "bake": { "oneOf": [
            { "enum": ["position", "localPosition", "normal", "uv", "componentId", "chartId"], "description": "normal is the bind-pose surface normal, each axis mapped -1..1 to 0..1 (recover the vector as v * 2 - 1; dot(v, [0, 0, 1]) reads how far it points up). uv is the texel's coordinates as a vec2 (dot(v, [1, 0]) reads u, dot(v, [0, 1]) reads v). componentId and chartId: the mesh analysis' id map for that source (connected pieces, UV charts), each texel the region id / 255, rasterised once per geometry." },
            { "$ref": "#/$defs/oneKey", "required": ["partition"], "properties": { "partition": { "oneOf": [
                { "enum": ["body", "hands", "forearms", "feet", "calves", "head", "hair", "amulet", "ring", "shield", "tail"] }, { "type": "integer", "minimum": 30, "maximum": 61 } ] } } },
            { "$ref": "#/$defs/oneKey", "required": ["boneWeight"], "properties": { "boneWeight": { "type": "array", "maxItems": 4096, "minItems": 1, "items": { "$ref": "#/$defs/node" } } } } ] } } },
        { "required": ["distance"], "properties": { "distance": { "$ref": "#/$defs/node", "description": "Distance from this skeleton node, bind pose, 0..256 units as 0..1. A distance from a fixed point is distance() of a position bake in a mask." } } },
        { "required": ["ripple"], "properties": { "ripple": {
            "type": "object", "additionalProperties": false, "required": ["trigger"],
            "properties": {
              "trigger": { "$ref": "#/$defs/ref" }, "speed": { "$ref": "#/$defs/param" },
              "width": { "$ref": "#/$defs/param" }, "decay": { "$ref": "#/$defs/param" },
              "shape": { "enum": ["ring", "disc"] },
              "direction": { "$ref": "#/$defs/vec3", "description": "A worldspace vector the wave travels along; the front is a plane sweeping from the anchor. Absent or zero radiates as a ring or disc from the anchor point. Animatable, so a signal (e.g. a payload carrying a hit direction) can steer it." } } } } },
        { "required": ["materialClusters"], "properties": { "materialClusters": {
            "type": "object", "additionalProperties": false,
            "description": "The material's cluster map: each texel the id / 255 of the nearest cluster under these settings, rendered once per geometry. Every field has a default.",
            "properties": {
              "clusters": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 },
              "weights": { "type": "object", "additionalProperties": false, "description": "How much each channel counts in the distance between texels.",
                "properties": {
                  "roughness": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 1 }, "metallic": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 1 },
                  "occlusion": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 0.5 }, "reflectance": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 0.5 },
                  "luma": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 1 },
                  "color": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 10, "default": 1, "description": "Diffuse RGB distance, averaged over three channels." } } },
              "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 1, "description": "The same seed and sample give the same clusters." },
              "iterations": { "type": "integer", "minimum": 1, "maximum": 256, "default": 32, "description": "The k-means cap." } } } } }
      ]
    },

    "layer": {
      "type": "object", "additionalProperties": false, "required": ["source", "opacity"],
      "properties": {
        "source": { "oneOf": [ { "$ref": "#/$defs/ref" }, { "$ref": "#/$defs/numbers3" } ], "description": "@source, @mask, or a constant colour." },
        "curve": { "$ref": "#/$defs/curveRef" },
        "blend": { "enum": ["replace", "multiply", "add", "subtract", "screen", "reorient"], "default": "replace", "description": "reorient is normal-map reorientation, allowed only on a normal stack." },
        "opacity": { "$ref": "#/$defs/param" },
        "color": { "$ref": "#/$defs/color" },
        "mask": { "$ref": "#/$defs/ref" },
        "channels": { "type": "string", "pattern": "^(?=.*[rgba])[rgba]{1,4}$" },
        "note": { "$ref": "#/$defs/note" }
      }
    },

    "output": {
      "oneOf": [
        { "type": "object", "required": ["target", "slot"],
          "properties": {
            "target": { "enum": ["material", "shell"] },
            "slot": { "enum": ["diffuse", "emissive", "rmaos", "normal", "height", "fuzz", "glint", "coat", "subsurface"] },
            "strength": { "$ref": "#/$defs/param", "description": "emissive: the property's emissive multiplier." },
            "scale": { "$ref": "#/$defs/param", "description": "height: displacement scale." },
            "color": { "$ref": "#/$defs/color", "description": "fuzz or subsurface colour." },
            "weight": { "$ref": "#/$defs/param", "description": "fuzz weight." },
            "screenSpaceScale": { "$ref": "#/$defs/param" }, "logMicrofacetDensity": { "$ref": "#/$defs/param" },
            "microfacetRoughness": { "$ref": "#/$defs/param" }, "densityRandomization": { "$ref": "#/$defs/param" },
            "roughness": { "$ref": "#/$defs/param", "description": "coat roughness." }, "level": { "$ref": "#/$defs/param", "description": "coat level." },
            "thickness": { "$ref": "#/$defs/param", "description": "subsurface thickness." },
            "selector": { "$ref": "#/$defs/selector" },
            "replace": { "type": "boolean", "description": "Clear preceding recipe groups on this geometry/surface/slot, preserving all selected sibling outputs in this recipe. No matching output means no replacement." },
            "resolution": { "enum": ["full", "half", "quarter"], "description": "Override the slot's default target resolution: a fraction of the material's native map size. Default by slot: normal and height full, diffuse and rmaos half, emissive and the response slots quarter." },
            "stack": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/layer" } },
            "note": { "$ref": "#/$defs/note" }
          },
          "additionalProperties": false,
          "allOf": [
            { "if": { "properties": { "slot": { "const": "emissive" } } }, "then": { "required": ["strength"] } },
            { "if": { "properties": { "slot": { "const": "height" } } }, "then": { "required": ["scale"] } },
            { "if": { "properties": { "slot": { "const": "fuzz" } } }, "then": { "required": ["color", "weight"] } },
            { "if": { "properties": { "slot": { "const": "coat" } } }, "then": { "required": ["roughness", "level"] } },
            { "if": { "properties": { "slot": { "const": "subsurface" } } }, "then": { "required": ["color", "thickness"] } }
          ] },
        { "type": "object", "required": ["target", "bones", "color", "intensity"], "additionalProperties": false,
          "properties": {
            "target": { "const": "light" },
            "bones": { "oneOf": [
              { "$ref": "#/$defs/oneKey", "required": ["skinned"], "properties": { "skinned": {
                  "type": "object", "additionalProperties": false,
                  "properties": { "max": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "minShare": { "$ref": "#/$defs/number", "minimum": 0.3, "maximum": 1, "description": "The least skin-weight share a bone needs to receive an emitter. The renderer floors it at 0.3 to bound the light count." } } } } },
              { "$ref": "#/$defs/oneKey", "required": ["named"], "properties": { "named": { "type": "array", "maxItems": 4096, "minItems": 1, "items": { "$ref": "#/$defs/node" } } } } ] },
            "offset": { "$ref": "#/$defs/vec3", "description": "Bone space." },
            "color": { "$ref": "#/$defs/color" },
            "intensity": { "$ref": "#/$defs/param" },
            "size": { "$ref": "#/$defs/param", "description": "ISL source size, 0.01..50." },
            "cutoff": { "$ref": "#/$defs/param", "description": "ISL cutoff override, 0.01..1; 1 = default." },
            "shadow": { "type": "boolean", "default": false, "description": "Shadow-casting; fixed at creation, subject to the engine's shadow-light cap." },
            "selector": { "$ref": "#/$defs/selector" },
            "replace": { "type": "boolean", "description": "Clear preceding eligible actor-wide light recipe groups, including other pieces; retain this recipe group's separate enchantment instances. Only a selected live third-person placement can replace lights." },
            "note": { "$ref": "#/$defs/note" }
          } }
      ]
    },

    "shell": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "material": { "enum": ["pbrCopy", "vanilla"], "default": "pbrCopy" },
        "blend": { "enum": ["additive", "alpha"], "default": "additive" },
        "depthBias": { "type": "boolean", "default": true },
        "alphaTest": { "$ref": "#/$defs/number", "minimum": 0, "maximum": 1, "default": 0 },
        "opacity": { "$ref": "#/$defs/param" },
        "rimPower": { "$ref": "#/$defs/param", "description": "Vanilla material only." },
        "emissive": { "$ref": "#/$defs/param", "description": "Vanilla material only." },
        "pose": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "inflate": { "$ref": "#/$defs/vec3", "description": "Fractions per bone-space axis; X runs along the bone." },
            "offset": { "$ref": "#/$defs/vec3", "description": "World space." },
            "scale": { "$ref": "#/$defs/param" },
            "scalePoint": { "$ref": "#/$defs/numbers3" },
            "spin": { "$ref": "#/$defs/param", "description": "Turns." },
            "spinAxis": { "$ref": "#/$defs/numbers3" }
          }
        }
      }
    },

    "variant": {
      "type": "object", "additionalProperties": false, "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "oneOf": [
          { "$ref": "#/$defs/oneKey", "required": ["armor"], "properties": { "armor": { "$ref": "#/$defs/form" } } },
          { "$ref": "#/$defs/oneKey", "required": ["selector"], "properties": { "selector": { "$ref": "#/$defs/selector" } } } ] },
        "overrides": { "type": "object", "maxProperties": 4096, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/value" } }
      }
    }
  }
}
