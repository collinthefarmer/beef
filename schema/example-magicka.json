{
  "format": 1,
  "name": "Magicka (vanilla)",
  "description": "EnchArmorMagickaFXS as the importer writes it, plus a hit ring and a footstep ripple.",
  "imported": "BetterEnchantmentEffects 0.1.0",
  "keys": [ { "effectShader": "EnchArmorMagickaFXS" } ],
  "clock": { "speed": 1.0 },

  "signals": {
    "fillLevel": { "efsh": { "field": "fillAlpha", "record": "EnchArmorMagickaFXS" }, "curve": "@rest" },
    "edgeLevel": { "efsh": { "field": "edgeAlpha", "record": "EnchArmorMagickaFXS" }, "curve": "@edgeRest" },
    "edgeColor": { "efsh": { "field": "edgeColor", "record": "EnchArmorMagickaFXS" } },
    "scroll":    { "efsh": { "field": "scroll",    "record": "EnchArmorMagickaFXS" } },

    "glowHue":      { "constant": [0.155, 0.388, 1.0] },
    "glowStrength": { "constant": 1.0 },
    "glowLevel":    { "expr": "@glowStrength * @fillLevel" },

    "sheenScale":   { "constant": 0.5 },
    "sheenWeight":  { "expr": "clamp(@edgeLevel * @sheenScale, 0, 1)" },
    "sheenScroll":  { "expr": "@scroll + 0.5" },

    "shimmerScale": { "constant": 0.1 },
    "heightScale":  { "expr": "@shimmerScale * clamp(@fillLevel, 0, 2)" },
    "shimmerScroll": { "expr": "@scroll + 0.25" },

    "glossBoost":   { "constant": 0.25 },
    "glossAmount":  { "expr": "@glossBoost * saturate(@fillLevel)" },

    "lightLevel":   { "expr": "clamp(@fillLevel, 0, 2)" },
    "shellOpacity": { "expr": "saturate(0.5 * clamp(@fillLevel, 0, 2))" },
    "inflate":      { "expr": "(1 + clamp(@fillLevel, 0, 2)) * 0.01" },

    "struck": { "trigger": { "event": "hit.received", "lifetime": 1.5, "max": 3 }, "curve": "@flash" },
    "step":   { "trigger": { "event": "anim.FootLeft", "anchor": { "node": "NPC L Foot [Lft ]" }, "lifetime": 0.6, "max": 2 }, "curve": "@flash" }
  },

  "curves": {
    "rest":     "x / 0.05",
    "edgeRest": "x / 0.9",
    "flash":    "pow(1 - x, 2)",
    "crisp":    "(x - mean) * 3 + 0.5",
    "punchy":   "(x - mean) * 2 + 0.5"
  },

  "sources": {
    "fill":         { "image": { "path": "Effects\\DarkSwirls.dds", "scroll": "@scroll", "tile": [3, 3] } },
    "sheenField":   { "image": { "path": "Effects\\DarkSwirls.dds", "channel": "luma", "scroll": "@sheenScroll", "tile": [3, 3], "mirror": [false, true] } },
    "shimmerField": { "image": { "path": "Effects\\DarkSwirls.dds", "channel": "luma", "scroll": "@shimmerScroll", "tile": [3, 3], "transpose": true, "mip": 2 } },
    "glossField":   { "image": { "path": "Effects\\DarkSwirls.dds", "channel": "luma", "scroll": "@scroll", "tile": [3, 3], "mip": 1 } },
    "relief":       { "material": "relief" },
    "metallic":     { "material": "metallic" },
    "ring":         { "ripple": { "trigger": "@struck", "speed": 90, "width": 8, "decay": 1.2 } },
    "stepRing":     { "ripple": { "trigger": "@step", "speed": 60, "width": 5, "decay": 2 } }
  },

  "masks": {
    "metal": "@metallic"
  },

  "outputs": [
    { "target": "shell", "slot": "emissive", "strength": "@glowLevel",
      "stack": [
        { "source": "@fill",     "blend": "replace", "opacity": 1.0, "color": "@glowHue", "mask": "@metal" },
        { "source": "@ring",     "blend": "add",     "opacity": "@struck", "color": "@glowHue" },
        { "source": "@stepRing", "blend": "add",     "opacity": "@step",   "color": "@glowHue" }
      ] },
    { "target": "shell", "slot": "fuzz", "color": "@edgeColor", "weight": "@sheenWeight",
      "stack": [
        { "source": [1, 1, 1],     "blend": "replace", "opacity": 1.0 },
        { "source": "@sheenField", "blend": "replace", "opacity": 1.0, "channels": "a" }
      ] },
    { "target": "material", "slot": "height", "scale": "@heightScale",
      "stack": [
        { "source": "@relief",       "curve": "@crisp", "blend": "replace", "opacity": 1.0 },
        { "source": "@shimmerField", "blend": "add", "opacity": 0.35 }
      ] },
    { "target": "material", "slot": "rmaos",
      "stack": [
        { "source": "@glossField", "curve": "@punchy", "blend": "subtract", "opacity": "@glossAmount", "channels": "r" }
      ] },
    { "target": "light", "bones": { "skinned": { "max": 2 } }, "offset": [0, 0, 0],
      "color": "@glowHue", "intensity": "@lightLevel", "size": 1.4, "cutoff": 0.05, "shadow": false }
  ],

  "shell": {
    "material": "pbrCopy", "blend": "additive", "depthBias": true, "opacity": "@shellOpacity",
    "pose": { "inflate": [0, "@inflate", "@inflate"] }
  },

  "variants": [
    { "name": "ebony", "key": { "armor": "ArmorEbonyCuirass" }, "overrides": { "glowHue": [0.6, 0.2, 1.0], "glowStrength": 1.5 } }
  ]
}
