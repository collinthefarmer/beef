#!/usr/bin/env bash
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- 'src/*.cpp' 'src/*.h' | grep -Ev '^src/(_old|extern|cs)/')
[ ${#files[@]} -eq 0 ] && exit 0

if ! tools/format.sh --check "${files[@]}"; then
	{
		echo
		echo "commit blocked: staged files are not clang-formatted. run:"
		echo "    tools/format.sh ${files[*]}"
		echo "then restage them and commit again."
	} >&2
	exit 1
fi
