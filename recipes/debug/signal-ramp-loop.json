{
  "format": 1,
  "name": "signal-ramp-loop",
  "author": "Claude",
  "description": "Ramp that repeats (via frac()). Tests: ramp with looping.",
  "priority": -91,
  "keys": ["default"],
  "signals": {
    "rampOnce": {
      "ramp": {
        "from": 0,
        "to": 1,
        "seconds": 3.0
      },
      "note": "Base ramp 0→1 over 3 seconds"
    },
    "rampLooped": {
      "expr": "frac(@rampOnce)",
      "note": "Fractional part repeats the ramp"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@rampLooped",
      "stack": [
        {
          "source": [0, 0.5, 0],
          "opacity": 1.0
        }
      ],
      "note": "Repeating ramp green emissive"
    }
  ]
}
