{
  "format": 1,
  "name": "source-ripple-interference",
  "description": "Diagnostic: visualize ripple pattern with concentric waves",
  "keys": ["default"],
  "priority": -76,
  "signals": {
    "rippleTrigger": {
      "trigger": {
        "event": "hit.received",
        "lifetime": 5,
        "max": 10
      }
    }
  },
  "sources": {
    "ripplePattern": {
      "ripple": {
        "trigger": "@rippleTrigger",
        "speed": 2.0,
        "width": 0.5,
        "decay": 0.3,
        "shape": "ring"
      },
      "note": "Concentric ring ripple pattern emanating from anchor"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": 0.8,
      "stack": [
        {
          "source": "@ripplePattern",
          "opacity": 1.0
        }
      ],
      "note": "Ripple pattern visualized as emissive glow"
    },
    {
      "target": "material",
      "slot": "height",
      "scale": 0.08,
      "stack": [
        {
          "source": "@ripplePattern",
          "opacity": 1.0
        }
      ],
      "note": "Ripple pattern as height displacement"
    }
  ]
}
