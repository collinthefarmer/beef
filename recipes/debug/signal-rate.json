{
  "format": 1,
  "name": "signal-rate",
  "author": "Claude",
  "description": "Rate of change of health (derivative) → color intensity. Tests: rate signal.",
  "priority": -81,
  "keys": ["default"],
  "signals": {
    "healthCurrent": {
      "av": {
        "of": "Health",
        "measure": "current"
      },
      "note": "Current health value"
    },
    "healthRate": {
      "rate": "@healthCurrent",
      "note": "Rate of health change per second (negative when taking damage)"
    },
    "damageRate": {
      "expr": "saturate(abs(@healthRate) / 100)",
      "note": "Damage rate as 0–1 intensity"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@damageRate",
      "stack": [
        {
          "source": [0.5, 0, 0],
          "opacity": 1.0
        }
      ],
      "note": "Damage rate indicator: red intensity"
    }
  ]
}
