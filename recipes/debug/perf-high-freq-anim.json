{
  "format": 1,
  "name": "perf-high-freq-anim",
  "author": "collinthefarmer@gmail.com",
  "description": "Performance: wave at 10 Hz updating every frame. Tests animation speed.",
  "priority": -37,
  "keys": ["default"],
  "signals": {
    "fast_wave": {
      "wave": {
        "base": 0.5,
        "amplitude": 0.5,
        "period": 0.1,
        "waveform": "sine"
      }
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@fast_wave",
      "stack": [
        {
          "source": [1.0, 0.5, 0.2],
          "opacity": 1.0
        }
      ]
    }
  ]
}
