{
  "format": 1,
  "name": "signal-av-health",
  "author": "Claude",
  "description": "Health % (current/max) → green at full, red at 0. Tests: av signal, scaling.",
  "priority": -89,
  "keys": ["default"],
  "signals": {
    "healthCurrent": {
      "av": {
        "of": "Health",
        "measure": "current"
      },
      "note": "Current health value"
    },
    "healthMax": {
      "av": {
        "of": "Health",
        "measure": "max"
      },
      "note": "Maximum health value"
    },
    "healthPercent": {
      "expr": "@healthCurrent / @healthMax",
      "note": "Health as a 0–1 fraction"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@healthPercent",
      "stack": [
        {
          "source": [0.5, 0.5, 0],
          "opacity": 1.0
        }
      ],
      "note": "Health status emissive: green when full, red when depleted"
    }
  ]
}
