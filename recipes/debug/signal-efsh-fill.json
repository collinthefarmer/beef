{
  "format": 1,
  "name": "signal-efsh-fill",
  "author": "Claude",
  "description": "Read fillAlpha from a dummy effect shader, drive emissive. Tests: efsh field read.",
  "priority": -90,
  "keys": ["default"],
  "signals": {
    "fillAlphaValue": {
      "efsh": {
        "field": "fillAlpha",
        "record": "DefaultObjectReference"
      },
      "note": "Read fillAlpha from effect shader"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@fillAlphaValue",
      "stack": [
        {
          "source": [1, 0.5, 1],
          "opacity": 1.0
        }
      ],
      "note": "Emissive driven by effect shader fillAlpha: magenta"
    }
  ]
}
