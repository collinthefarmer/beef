{
  "format": 1,
  "name": "inspect-stamina",
  "author": "collinthefarmer@gmail.com",
  "description": "Actor state: stamina % hue green (full) to red (depleted). Tests av as color.",
  "priority": -42,
  "keys": ["default"],
  "signals": {
    "stamina_current": {
      "av": {
        "of": "Stamina",
        "measure": "current"
      }
    },
    "stamina_max": {
      "av": {
        "of": "Stamina",
        "measure": "max"
      }
    },
    "stamina_ratio": {
      "expr": "@stamina_current / @stamina_max"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@stamina_ratio",
      "stack": [
        {
          "source": [0.5, 0.5, 0.0],
          "opacity": 1.0
        }
      ]
    }
  ]
}
