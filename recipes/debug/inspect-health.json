{
  "format": 1,
  "name": "inspect-health",
  "author": "collinthefarmer@gmail.com",
  "description": "Actor state: brightness tracks health %, color is green. Tests av visibility.",
  "priority": -45,
  "keys": ["default"],
  "signals": {
    "health_current": {
      "av": {
        "of": "Health",
        "measure": "current"
      }
    },
    "health_max": {
      "av": {
        "of": "Health",
        "measure": "max"
      }
    },
    "health_ratio": {
      "expr": "@health_current / @health_max"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@health_ratio",
      "stack": [
        {
          "source": [0.0, 1.0, 0.0],
          "opacity": 1.0
        }
      ]
    }
  ]
}
