{
  "format": 1,
  "name": "inspect-combat",
  "author": "collinthefarmer@gmail.com",
  "description": "Actor state: combat -> bright red, else dim green. Tests state visibility.",
  "priority": -44,
  "keys": ["default"],
  "signals": {
    "in_combat": {
      "actorState": "inCombat"
    },
    "not_combat": {
      "expr": "1 - @in_combat"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": 1.0,
      "stack": [
        {
          "source": [1.0, 0.0, 0.0],
          "opacity": "@in_combat"
        },
        {
          "source": [0.3, 1.0, 0.0],
          "opacity": "@not_combat",
          "blend": "add"
        }
      ]
    }
  ]
}
