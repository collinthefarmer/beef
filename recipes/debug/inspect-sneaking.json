{
  "format": 1,
  "name": "inspect-sneaking",
  "author": "collinthefarmer@gmail.com",
  "description": "Actor state: sneaking -> opacity 0.3, else 1.0. Tests state toggle.",
  "priority": -43,
  "keys": ["default"],
  "signals": {
    "sneaking": {
      "actorState": "sneaking"
    },
    "sneaking_opacity": {
      "expr": "if(@sneaking, 0.3, 1.0)"
    }
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": 1.0,
      "stack": [
        {
          "source": [1.0, 1.0, 0.0],
          "opacity": "@sneaking_opacity"
        }
      ]
    }
  ]
}
