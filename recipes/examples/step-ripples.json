{
  "format": 1,
  "name": "Step ripples",
  "author": "WornEnchantmentPBR",
  "description": "Footfalls send a ring out from each foot over the boots. Keyed by the ArmorBoots keyword so it stacks on whatever enchantment recipe the boots resolve to; the emissive output replaces that recipe's so the rings read clearly.",
  "keys": [ { "keyword": "ArmorBoots" } ],
  "priority": 50,

  "signals": {
    "strength": { "constant": 2.0 },
    "stepLeft":  { "trigger": { "event": "anim.Foot*Left",  "at": "NPC L Foot [Lft ]", "lifetime": 1.0, "max": 3 } },
    "stepRight": { "trigger": { "event": "anim.Foot*Right", "at": "NPC R Foot [Rft ]", "lifetime": 1.0, "max": 3 } }
  },

  "sources": {
    "leftRing":  { "ripple": { "trigger": "@stepLeft",  "speed": 90, "width": 5, "decay": 2.0 } },
    "rightRing": { "ripple": { "trigger": "@stepRight", "speed": 90, "width": 5, "decay": 2.0 } }
  },

  "masks": {
    "rings": "max(@leftRing, @rightRing)"
  },

  "outputs": [
    { "target": "material", "slot": "emissive", "strength": "@strength", "replace": true,
      "stack": [
        { "source": [0.4, 0.9, 1.0], "opacity": 1.0, "mask": "@rings" }
      ] }
  ]
}
