{
  "format": 1,
  "name": "Winterglass",
  "description": "Exact-form frost for the demo Dwarven cuirass: five-second growth across the original material, stacking with Arcane Circuit and Resonant Ward.",
  "keys": [
    {
      "armor": "0x803~BetterEnchantmentEffectsDemo.esp"
    }
  ],
  "merge": "stack",
  "signals": {
    "growth": {
      "ramp": {
        "from": 0,
        "to": 1,
        "seconds": 5
      }
    }
  },
  "sources": {
    "uv": {
      "bake": "uv"
    },
    "metallic": {
      "material": "metallic"
    },
    "relief": {
      "material": "relief"
    }
  },
  "masks": {
    "u": "dot(@uv, [1, 0])",
    "v": "dot(@uv, [0, 1])",
    "crystals": "0.5 + 0.5 * sin(@u * 72 * pi + 2 * sin(@v * 24 * pi)) * cos(@v * 96 * pi)",
    "terrain": "saturate(0.65 * @crystals + 0.35 * @relief)",
    "frost": "smoothstep(0.05, 0.25, @growth - 0.7 * @terrain) * smoothstep(0.25, 0.75, @metallic)",
    "ridge": "@frost * (0.25 + 0.75 * @crystals)"
  },
  "outputs": [
    {
      "target": "material",
      "slot": "diffuse",
      "resolution": "half",
      "stack": [
        {
          "source": [
            0.58,
            0.78,
            0.88
          ],
          "blend": "replace",
          "opacity": 0.65,
          "mask": "@frost",
          "channels": "rgb"
        }
      ]
    },
    {
      "target": "material",
      "slot": "rmaos",
      "resolution": "half",
      "stack": [
        {
          "source": [
            0.82,
            0.82,
            0.82
          ],
          "blend": "replace",
          "opacity": 0.8,
          "mask": "@frost",
          "channels": "r"
        }
      ]
    },
    {
      "target": "material",
      "slot": "height",
      "scale": 0.015,
      "resolution": "full",
      "stack": [
        {
          "source": "@ridge",
          "blend": "add",
          "opacity": 0.12,
          "channels": "r"
        }
      ]
    }
  ]
}
