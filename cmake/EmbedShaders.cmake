string(REPLACE "|" ";" files "${FILES}")
list(SORT files)
list(LENGTH files count)
set(delimiter "beefhlsl")
set(rows "")
foreach(file IN LISTS files)
  get_filename_component(name "${file}" NAME_WE)
  file(READ "${file}" text)
  string(FIND "${text}" ")${delimiter}\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${file} contains the raw string delimiter ${delimiter}")
  endif()
  string(APPEND rows "    {\"${name}\", R\"${delimiter}(${text})${delimiter}\"},\n")
endforeach()
set(content "// Generated by cmake/EmbedShaders.cmake from src/shaders.
#include \"planners/ShaderFiles.h\"

#include <array>

namespace BetterEnchantmentEffects {
namespace {
constexpr std::array<ShaderFile, ${count}> kFiles{{
${rows}}};
}

std::span<const ShaderFile> ShaderFiles() noexcept { return kFiles; }
}
")
file(WRITE "${OUTPUT}" "${content}")
