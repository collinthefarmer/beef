{
  "format": 1,
  "name": "Fill import template",
  "description": "The baseline import template for an effect shader with a fill texture. A pick lights a few texture charts of one material group on one of the piece's geometries. There the material glows, darker and brighter in drifting patches and, at strong magnitudes, slightly varied in hue, in the shader's colour (or, when that colour is nearly white, its edge colour or a hue seeded by the effect), turned in hue by the effect and deeper and darker at weak magnitudes, takes a roughness and metallic chosen by the enchantment, and sinks into a relief; a shell copy of the piece covers it, with holes cut by baked noise over the piece's bind-pose position, in one of three styles (blobs, ridges, cracks), sometimes stretched into streaks and usually inverted (the shell left as veins or a web of cracks over the glow), chosen by the enchantment, seamless across its UV charts and drifting as three noise fields cross-fade, through which the glow shows. Weak enchantments show faintly: the glow and the sheen scale with a presence that eases in up to 0.6 magnitude level, so light only peeks through the holes. The holes pulse gently in size, grow with the enchantment's magnitude and with distance from the spine, so the effect gathers at the extremities; the glow pulses very slightly, scales with magnitude and grows brighter as its share of the texture shrinks, as do the relief (flat at weak magnitudes), how many charts light and the least share of the geometry they cover. Under the shell the picked area also carries a fuzz sheen in the glow's hue, slightly brightened, a halo at grazing angles. The enchantment, its effect and the worn item fix which geometry, material group and charts glow, always at least one chart.",
  "keys": [
    {
      "effectShader": "ImportedEffectShader"
    }
  ],
  "signals": {
    "itemHash": {
      "item": "itemHash"
    },
    "shaderFill": {
      "efsh": {
        "field": "fillAlpha",
        "record": "ImportedEffectShader"
      }
    },
    "importFillBase": {
      "constant": 1.0
    },
    "shaderPulse": {
      "expr": "@shaderFill / @importFillBase"
    },
    "shaderEdgeColor": {
      "efsh": {
        "field": "edgeColor",
        "record": "ImportedEffectShader"
      }
    },
    "importHue": {
      "constant": [
        1.0,
        1.0,
        1.0
      ]
    },
    "magnitudeRaw": {
      "enchantment": "magnitude"
    },
    "magnitudeHalf": {
      "constant": 50.0
    },
    "magnitudeLevel": {
      "expr": "max(@magnitudeRaw, 0) / (max(@magnitudeRaw, 0) + @magnitudeHalf)"
    },
    "magnitudeFloor": {
      "constant": 0.0
    },
    "chartMaxLit": {
      "constant": 3.0
    },
    "chartMagnitudeWeight": {
      "constant": 0.33
    },
    "chartMagnitude": {
      "expr": "max(@magnitudeFloor, 1 + @chartMagnitudeWeight * (2 * @magnitudeLevel - 1))"
    },
    "chartMaxLitScaled": {
      "expr": "max(1, @chartMaxLit * @chartMagnitude)"
    },
    "chartLit": {
      "expr": "randrange(1, floor(@chartMaxLitScaled) + 1)"
    },
    "chartMinShareBase": {
      "constant": 0.15
    },
    "chartMinShare": {
      "expr": "saturate(@chartMinShareBase * @chartMagnitude)"
    },
    "pickSeed": {
      "expr": "frac(rand() + @itemHash)"
    },
    "effectHash": {
      "enchantment": "effectHash"
    },
    "enchantmentHash": {
      "enchantment": "idHash"
    },
    "glowStrength": {
      "constant": 0.3
    },
    "glowPulseDepth": {
      "constant": 0.04
    },
    "glowPulsePeriod": {
      "constant": 4.5
    },
    "glowPulse": {
      "expr": "1 + @glowPulseDepth * sin(time * 6.2832 / @glowPulsePeriod)"
    },
    "glowMagnitudeGain": {
      "constant": 2.0
    },
    "presenceWeak": {
      "constant": 0.25
    },
    "presence": {
      "expr": "lerp(@presenceWeak, 1, pow(@colourStrength, 2))"
    },
    "glowPresenceWeak": {
      "constant": 0.12
    },
    "glowPresence": {
      "expr": "lerp(@glowPresenceWeak, 1, pow(@colourStrength, 2))"
    },
    "glowIntensity": {
      "expr": "@glowStrength * (1 + @glowMagnitudeGain * @magnitudeLevel) * @glowPulse * @glowPresence"
    },
    "glowHueRange": {
      "constant": 0.1
    },
    "glowHueTurn": {
      "expr": "lerp(-@glowHueRange, @glowHueRange, @effectHash)"
    },
    "colourChromaMin": {
      "constant": 0.35
    },
    "sourceChroma": {
      "expr": "max(max(dot(@importHue, [1, 0, 0]), dot(@importHue, [0, 1, 0])), dot(@importHue, [0, 0, 1])) - min(min(dot(@importHue, [1, 0, 0]), dot(@importHue, [0, 1, 0])), dot(@importHue, [0, 0, 1]))"
    },
    "edgeChroma": {
      "expr": "max(max(dot(@shaderEdgeColor, [1, 0, 0]), dot(@shaderEdgeColor, [0, 1, 0])), dot(@shaderEdgeColor, [0, 0, 1])) - min(min(dot(@shaderEdgeColor, [1, 0, 0]), dot(@shaderEdgeColor, [0, 1, 0])), dot(@shaderEdgeColor, [0, 0, 1]))"
    },
    "seededHue": {
      "expr": "hue(@effectHash)"
    },
    "fallbackColour": {
      "expr": "if(@edgeChroma >= @colourChromaMin, @shaderEdgeColor, @seededHue)"
    },
    "baseColour": {
      "expr": "lerp(@fallbackColour, @importHue, saturate(@sourceChroma / @colourChromaMin))"
    },
    "baseBrightest": {
      "expr": "max(max(dot(@baseColour, [1, 0, 0]), dot(@baseColour, [0, 1, 0])), dot(@baseColour, [0, 0, 1]))"
    },
    "vividColour": {
      "expr": "@baseColour / max(@baseBrightest, 0.001)"
    },
    "colourHue": {
      "expr": "hueShift(@vividColour, @glowHueTurn)"
    },
    "colourFullLevel": {
      "constant": 0.6
    },
    "colourStrength": {
      "expr": "saturate(@magnitudeLevel / @colourFullLevel)"
    },
    "colourDepthWeak": {
      "constant": 2.2
    },
    "colourValueWeak": {
      "constant": 0.55
    },
    "colourDepthPale": {
      "constant": 2.5
    },
    "colourChromaVivid": {
      "constant": 0.7
    },
    "vividChroma": {
      "expr": "max(max(dot(@vividColour, [1, 0, 0]), dot(@vividColour, [0, 1, 0])), dot(@vividColour, [0, 0, 1])) - min(min(dot(@vividColour, [1, 0, 0]), dot(@vividColour, [0, 1, 0])), dot(@vividColour, [0, 0, 1]))"
    },
    "colourDepthStrong": {
      "expr": "lerp(@colourDepthPale, 1, saturate(@vividChroma / @colourChromaVivid))"
    },
    "colourDepth": {
      "expr": "lerp(@colourDepthWeak, @colourDepthStrong, @colourStrength)"
    },
    "deepColour": {
      "expr": "pow(@colourHue, @colourDepth * [1, 1, 1])"
    },
    "deepBrightest": {
      "expr": "max(max(dot(@deepColour, [1, 0, 0]), dot(@deepColour, [0, 1, 0])), dot(@deepColour, [0, 0, 1]))"
    },
    "glowColor": {
      "expr": "@deepColour / max(@deepBrightest, 0.001) * lerp(@colourValueWeak, 1, @colourStrength)"
    },
    "holeBase": {
      "constant": 0.12
    },
    "holeMagnitudeWeight": {
      "constant": 0.14
    },
    "holePulseDepth": {
      "constant": 0.015
    },
    "holePulsePeriod": {
      "constant": 6.0
    },
    "holeThreshold": {
      "expr": "@holeBase + @holeMagnitudeWeight * @magnitudeLevel + @holePulseDepth * sin(time * 6.2832 / @holePulsePeriod)"
    },
    "holeSoftness": {
      "constant": 0.04
    },
    "surfaceIndex": {
      "expr": "floor(@enchantmentHash * 4)"
    },
    "surfaceRoughMetal": {
      "expr": "if(@surfaceIndex < 1, [0.15, 1, 0], if(@surfaceIndex < 2, [0.4, 1, 0], if(@surfaceIndex < 3, [0.12, 0, 0], [0.75, 0, 0])))"
    },
    "reliefDepth": {
      "constant": 0.35
    },
    "reliefFullLevel": {
      "constant": 0.6
    },
    "reliefScale": {
      "expr": "@reliefDepth * pow(saturate(@magnitudeLevel / @reliefFullLevel), 2)"
    },
    "haloWeightBase": {
      "constant": 0.6
    },
    "haloMagnitudeWeight": {
      "constant": 0.5
    },
    "haloWeight": {
      "expr": "saturate(@haloWeightBase * max(@magnitudeFloor, 1 + @haloMagnitudeWeight * (2 * @magnitudeLevel - 1)) * @presence)"
    },
    "haloValue": {
      "constant": 1.15
    },
    "haloColor": {
      "expr": "saturate(@glowColor * @haloValue)"
    },
    "extremityNear": {
      "constant": 0.1
    },
    "extremityFar": {
      "constant": 0.35
    },
    "extremityCore": {
      "constant": 0.35
    },
    "extremityTip": {
      "constant": 1.6
    },
    "noiseFlowPeriod": {
      "constant": 9.0
    },
    "noisePhase": {
      "expr": "time * 6.2832 / @noiseFlowPeriod + @effectHash * 6.2832"
    },
    "noiseWeights": {
      "expr": "([1, 1, 1] + [cos(@noisePhase), cos(@noisePhase - 2.0944), cos(@noisePhase - 4.1888)]) / 3"
    },
    "brightWeights": {
      "expr": "([1, 1, 1] + [cos(@noisePhase + 2.0944), cos(@noisePhase + 2.0944 - 2.0944), cos(@noisePhase + 2.0944 - 4.1888)]) / 3"
    },
    "hueWeights": {
      "expr": "([1, 1, 1] + [cos(@noisePhase + 4.1888), cos(@noisePhase + 4.1888 - 2.0944), cos(@noisePhase + 4.1888 - 4.1888)]) / 3"
    },
    "tintDark": {
      "constant": 0.6
    },
    "tintBright": {
      "constant": 1.35
    },
    "hueSpreadMax": {
      "constant": 0.08
    },
    "hueSpread": {
      "expr": "@hueSpreadMax * pow(@colourStrength, 2)"
    },
    "noiseStyle": {
      "expr": "min(floor(rand() * 3), 2)"
    },
    "noiseCell": {
      "expr": "if(@noiseStyle < 1, 7, if(@noiseStyle < 2, 10, 8))"
    },
    "streakChance": {
      "constant": 0.35
    },
    "streakLength": {
      "constant": 4.0
    },
    "streakAcross": {
      "expr": "rand()"
    },
    "streaked": {
      "expr": "rand() < @streakChance"
    },
    "noiseStretch": {
      "expr": "if(@streaked, if(@streakAcross < 0.5, [@streakLength, 1, 1], [1, 1, @streakLength]), [1, 1, 1])"
    },
    "noiseMean": {
      "expr": "if(@noiseStyle < 1, 0.5, if(@noiseStyle < 2, 0.25, 0.3))"
    },
    "noiseShift": {
      "expr": "if(@noiseStyle < 1, 0.25, if(@noiseStyle < 2, -0.04, -0.06))"
    },
    "invertChance": {
      "constant": 0.7
    },
    "noiseInverted": {
      "expr": "rand() < @invertChance"
    }
  },
  "curves": {
    "areaGain": "x * clamp(0.05 / max(mean, 0.001), 0.5, 4)"
  },
  "sources": {
    "lit": {
      "pick": {
        "seed": "@pickSeed",
        "levels": [
          {
            "from": "geometries"
          },
          {
            "from": "groups"
          },
          {
            "from": "charts",
            "count": "@chartLit",
            "minShare": "@chartMinShare"
          }
        ]
      }
    },
    "fromCore": {
      "distance": "NPC Spine1 [Spn1]"
    },
    "noise": {
      "mesh": {
        "noise": {
          "cell": "@noiseCell",
          "octaves": 2,
          "style": "@noiseStyle",
          "stretch": "@noiseStretch"
        }
      }
    }
  },
  "masks": {
    "holeNoise": "@noiseMean + (dot(@noise, @noiseWeights) - @noiseMean) * 1.4142",
    "holeField": "if(@noiseInverted, 2 * @noiseMean - @holeNoise, @holeNoise)",
    "brightNoise": "@noiseMean + (dot(@noise, @brightWeights) - @noiseMean) * 1.4142",
    "hueNoise": "@noiseMean + (dot(@noise, @hueWeights) - @noiseMean) * 1.4142",
    "glowTint": "hueShift(@glowColor, (@hueNoise - @noiseMean) * @hueSpread) * lerp(@tintDark, @tintBright, saturate(@brightNoise + 0.5 - @noiseMean))",
    "extremity": "smoothstep(@extremityNear, @extremityFar, @fromCore)",
    "holeLevel": "@holeThreshold * lerp(@extremityCore, @extremityTip, @extremity)",
    "holes": "1 - smoothstep(@holeLevel + @noiseShift, @holeLevel + @noiseShift + @holeSoftness, @holeField)",
    "glowArea": "@holes * @lit",
    "shellCover": "@lit * (1 - @holes)"
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@glowIntensity",
      "resolution": "half",
      "stack": [
        {
          "source": "@glowTint",
          "opacity": 1.0,
          "mask": "@lit"
        },
        {
          "source": "@lit",
          "blend": "multiply",
          "opacity": 1.0,
          "curve": "@areaGain"
        }
      ]
    },
    {
      "target": "material",
      "slot": "rmaos",
      "stack": [
        {
          "source": [
            1.0,
            1.0,
            1.0
          ],
          "opacity": 1.0,
          "color": "@surfaceRoughMetal",
          "mask": "@lit",
          "channels": "rg"
        }
      ],
      "resolution": "half"
    },
    {
      "target": "material",
      "slot": "height",
      "scale": "@reliefScale",
      "resolution": "half",
      "stack": [
        {
          "source": [
            0.5,
            0.5,
            0.5
          ],
          "opacity": 1.0
        },
        {
          "source": "@glowArea",
          "blend": "subtract",
          "opacity": 0.5
        }
      ]
    },
    {
      "target": "material",
      "slot": "fuzz",
      "color": "@haloColor",
      "weight": "@haloWeight",
      "resolution": "half",
      "stack": [
        {
          "source": [
            1.0,
            1.0,
            1.0
          ],
          "opacity": 1.0,
          "channels": "rgb"
        },
        {
          "source": "@lit",
          "opacity": 1.0,
          "channels": "a"
        }
      ]
    },
    {
      "target": "shell",
      "slot": "diffuse",
      "stack": [
        {
          "source": "@shellCover",
          "opacity": 1.0,
          "channels": "a"
        }
      ]
    }
  ],
  "shell": {
    "blend": "alpha"
  }
}
