{
  "format": 1,
  "name": "Fill import template",
  "description": "The baseline import template for an effect shader with a fill texture. A pick lights a few texture charts of one material group on one of the piece's geometries. There the material glows in the shader's colour, turned in hue by the effect, takes a roughness and metallic chosen by the enchantment, and sinks into a relief; a shell copy of the piece covers it, with DarkSwirls holes through which the glow shows. The holes pulse gently in size, grow with the enchantment's magnitude and with distance from the spine, so the effect gathers at the extremities; the glow pulses very slightly and scales with magnitude, as do the relief, how many charts light and the least share of the geometry they cover. Under the shell the picked area also carries a fuzz sheen in the glow's hue, slightly brightened, a halo at grazing angles. The enchantment, its effect and the worn item fix which geometry, material group and charts glow, always at least one chart.",
  "keys": [
    {
      "effectShader": "ImportedEffectShader"
    }
  ],
  "signals": {
    "itemHash": {
      "item": "itemHash"
    },
    "shaderFill": {
      "efsh": {
        "field": "fillAlpha",
        "record": "ImportedEffectShader"
      }
    },
    "importFillBase": {
      "constant": 1.0
    },
    "shaderPulse": {
      "expr": "@shaderFill / @importFillBase"
    },
    "shaderEdgeColor": {
      "efsh": {
        "field": "edgeColor",
        "record": "ImportedEffectShader"
      }
    },
    "importHue": {
      "constant": [
        1.0,
        1.0,
        1.0
      ]
    },
    "magnitudeRaw": {
      "enchantment": "magnitude"
    },
    "magnitudeHalf": {
      "constant": 50.0
    },
    "magnitudeLevel": {
      "expr": "max(@magnitudeRaw, 0) / (max(@magnitudeRaw, 0) + @magnitudeHalf)"
    },
    "magnitudeFloor": {
      "constant": 0.0
    },
    "chartMaxLit": {
      "constant": 3.0
    },
    "chartMagnitudeWeight": {
      "constant": 0.33
    },
    "chartMagnitude": {
      "expr": "max(@magnitudeFloor, 1 + @chartMagnitudeWeight * (2 * @magnitudeLevel - 1))"
    },
    "chartMaxLitScaled": {
      "expr": "max(1, @chartMaxLit * @chartMagnitude)"
    },
    "chartLit": {
      "expr": "randrange(1, floor(@chartMaxLitScaled) + 1)"
    },
    "chartMinShareBase": {
      "constant": 0.15
    },
    "chartMinShare": {
      "expr": "saturate(@chartMinShareBase * @chartMagnitude)"
    },
    "pickSeed": {
      "expr": "frac(rand() + @itemHash)"
    },
    "effectHash": {
      "enchantment": "effectHash"
    },
    "enchantmentHash": {
      "enchantment": "idHash"
    },
    "glowStrength": {
      "constant": 0.3
    },
    "glowMagnitudeWeight": {
      "constant": 9.0
    },
    "glowMagnitude": {
      "expr": "max(@magnitudeFloor, 1 + @glowMagnitudeWeight * (2 * @magnitudeLevel - 1))"
    },
    "glowPulseDepth": {
      "constant": 0.04
    },
    "glowPulsePeriod": {
      "constant": 4.5
    },
    "glowPulse": {
      "expr": "1 + @glowPulseDepth * sin(time * 6.2832 / @glowPulsePeriod)"
    },
    "glowIntensity": {
      "expr": "@glowStrength * @glowMagnitude * @glowPulse"
    },
    "glowHueRange": {
      "constant": 0.1
    },
    "glowHueTurn": {
      "expr": "lerp(-@glowHueRange, @glowHueRange, @effectHash)"
    },
    "glowColor": {
      "expr": "hueShift(@importHue, @glowHueTurn)"
    },
    "swirlSize": {
      "constant": 1.0
    },
    "swirlSizeMin": {
      "constant": 0.2
    },
    "swirlTileA": {
      "expr": "[3, 3] / (@swirlSize * lerp(@swirlSizeMin, 1, rand()))"
    },
    "swirlTileB": {
      "expr": "[5, 5] / (@swirlSize * lerp(@swirlSizeMin, 1, rand()))"
    },
    "swirlSpeedBase": {
      "constant": 1.0
    },
    "swirlSpeedVariation": {
      "constant": 0.5
    },
    "swirlSpeed": {
      "expr": "@swirlSpeedBase * lerp(1 - @swirlSpeedVariation, 1 + @swirlSpeedVariation, rand())"
    },
    "swirlFlowA": {
      "expr": "time * [0.03, -0.02] * @swirlSpeed"
    },
    "swirlFlowB": {
      "expr": "time * [-0.01, 0.025] * @swirlSpeed"
    },
    "holeBase": {
      "constant": 0.06
    },
    "holeMagnitudeWeight": {
      "constant": 0.14
    },
    "holePulseDepth": {
      "constant": 0.015
    },
    "holePulsePeriod": {
      "constant": 6.0
    },
    "holeThreshold": {
      "expr": "@holeBase + @holeMagnitudeWeight * @magnitudeLevel + @holePulseDepth * sin(time * 6.2832 / @holePulsePeriod)"
    },
    "holeSoftness": {
      "constant": 0.04
    },
    "surfaceIndex": {
      "expr": "floor(@enchantmentHash * 4)"
    },
    "surfaceRoughMetal": {
      "expr": "if(@surfaceIndex < 1, [0.15, 1, 0], if(@surfaceIndex < 2, [0.4, 1, 0], if(@surfaceIndex < 3, [0.12, 0, 0], [0.75, 0, 0])))"
    },
    "reliefDepth": {
      "constant": 0.35
    },
    "reliefMagnitudeWeight": {
      "constant": 0.5
    },
    "reliefMagnitude": {
      "expr": "max(@magnitudeFloor, 1 + @reliefMagnitudeWeight * (2 * @magnitudeLevel - 1))"
    },
    "reliefScale": {
      "expr": "@reliefDepth * @reliefMagnitude"
    },
    "haloWeightBase": {
      "constant": 0.6
    },
    "haloMagnitudeWeight": {
      "constant": 0.5
    },
    "haloWeight": {
      "expr": "saturate(@haloWeightBase * max(@magnitudeFloor, 1 + @haloMagnitudeWeight * (2 * @magnitudeLevel - 1)))"
    },
    "haloValue": {
      "constant": 1.15
    },
    "haloColor": {
      "expr": "saturate(@glowColor * @haloValue)"
    },
    "extremityNear": {
      "constant": 0.1
    },
    "extremityFar": {
      "constant": 0.35
    },
    "extremityCore": {
      "constant": 0.35
    },
    "extremityTip": {
      "constant": 1.6
    }
  },
  "sources": {
    "lit": {
      "pick": {
        "seed": "@pickSeed",
        "levels": [
          {
            "from": "geometries"
          },
          {
            "from": "groups"
          },
          {
            "from": "charts",
            "count": "@chartLit",
            "minShare": "@chartMinShare"
          }
        ]
      }
    },
    "swirlA": {
      "image": {
        "path": "Effects\\DarkSwirls.dds",
        "channel": "luma",
        "space": "tiled",
        "tile": "@swirlTileA",
        "scroll": "@swirlFlowA"
      }
    },
    "swirlB": {
      "image": {
        "path": "Effects\\DarkSwirls.dds",
        "channel": "luma",
        "space": "tiled",
        "tile": "@swirlTileB",
        "scroll": "@swirlFlowB",
        "transpose": true
      }
    },
    "fromCore": {
      "distance": "NPC Spine1 [Spn1]"
    }
  },
  "masks": {
    "swirl": "@swirlA * @swirlB",
    "extremity": "smoothstep(@extremityNear, @extremityFar, @fromCore)",
    "holeLevel": "@holeThreshold * lerp(@extremityCore, @extremityTip, @extremity)",
    "holes": "1 - smoothstep(@holeLevel, @holeLevel + @holeSoftness, @swirl)",
    "glowArea": "@holes * @lit",
    "shellCover": "@lit * (1 - @holes)"
  },
  "outputs": [
    {
      "target": "material",
      "slot": "emissive",
      "strength": "@glowIntensity",
      "resolution": "half",
      "stack": [
        {
          "source": [
            1.0,
            1.0,
            1.0
          ],
          "opacity": 1.0,
          "color": "@glowColor",
          "mask": "@lit"
        }
      ]
    },
    {
      "target": "material",
      "slot": "rmaos",
      "stack": [
        {
          "source": [
            1.0,
            1.0,
            1.0
          ],
          "opacity": 1.0,
          "color": "@surfaceRoughMetal",
          "mask": "@lit",
          "channels": "rg"
        }
      ],
      "resolution": "half"
    },
    {
      "target": "material",
      "slot": "height",
      "scale": "@reliefScale",
      "resolution": "half",
      "stack": [
        {
          "source": [
            0.5,
            0.5,
            0.5
          ],
          "opacity": 1.0
        },
        {
          "source": "@glowArea",
          "blend": "subtract",
          "opacity": 0.5
        }
      ]
    },
    {
      "target": "material",
      "slot": "fuzz",
      "color": "@haloColor",
      "weight": "@haloWeight",
      "resolution": "half",
      "stack": [
        {
          "source": [
            1.0,
            1.0,
            1.0
          ],
          "opacity": 1.0,
          "channels": "rgb"
        },
        {
          "source": "@lit",
          "opacity": 1.0,
          "channels": "a"
        }
      ]
    },
    {
      "target": "shell",
      "slot": "diffuse",
      "stack": [
        {
          "source": "@shellCover",
          "opacity": 1.0,
          "channels": "a"
        }
      ]
    }
  ],
  "shell": {
    "blend": "alpha"
  }
}
